{
  "name": "morrow",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted personal hub for solo developers: notes, boards and todos.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build && vp pack",
    "start": "node .output/server/index.mjs",
    "test": "vp test",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "ready": "vp check && vp test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "catalog:",
    "@blocknote/core": "catalog:",
    "@blocknote/react": "catalog:",
    "@blocknote/shadcn": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "catalog:",
    "nitro": "3.0.261103-rc",
    "shadcn": "^4.23.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
